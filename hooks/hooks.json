{
  "description": "ani — the project's recorded patterns injected at session start, plus deterministic correction-signal and success-pattern hints on prompt submit (Tier 1 adapter; the core skill works without it).",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.cmd\" session-start",
            "shell": "bash",
            "async": false
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.cmd\" trigger",
            "shell": "bash"
          }
        ]
      }
    ]
  }
}
